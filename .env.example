# AI Hiring Prediction System - Environment Configuration

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKERS=4

# Frontend Configuration
FRONTEND_PORT=80

# Application Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_TITLE=AI Hiring Prediction System
API_VERSION=1.0.0
API_DESCRIPTION=Intelligent candidate evaluation and ranking system

# CORS Settings (for production, set specific origin)
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# Database Configuration (optional, for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/hiring_db

# Model Configuration
MODEL_PATH=./models/trained_model.pkl
PREPROCESSOR_PATH=./models/preprocessor.pkl
FEATURE_SCALER_PATH=./models/feature_scaler.pkl
SKILL_PROFILES_PATH=./models/role_required_skills.pkl

# Logging
LOG_FILE=./logs/app.log
MAX_LOG_SIZE=10485760  # 10MB
BACKUP_COUNT=5

# Security (for production)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Cache Configuration
CACHE_ENABLED=false
CACHE_TTL=3600

# Email Configuration (optional, for notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@gmail.com
# SENDER_PASSWORD=your-app-password

# AWS/Cloud Deployment (optional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=hiring-predictions-bucket

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn-here
# DATADOG_API_KEY=your-datadog-key
